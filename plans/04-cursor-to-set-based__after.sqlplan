<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.4025.3"><BatchSequence><Batch><Statements><StmtSimple StatementText="UPDATE i&#xa;SET    i.AmountPaid = ISNULL(p.Paid, 0),&#xa;       i.Status     = CASE WHEN ISNULL(p.Paid, 0) = 0  THEN 1&#xa;                           WHEN p.Paid &lt; i.GrossAmount THEN 2&#xa;                           ELSE 3 END&#xa;FROM   dbo.Invoice i&#xa;LEFT JOIN (SELECT   InvoiceId, Paid = SUM(Amount)&#xa;           FROM     dbo.Payment&#xa;           GROUP BY InvoiceId) p&#xa;       ON p.InvoiceId = i.InvoiceId&#xa;WHERE  i.InvoiceDate &gt;= &apos;20250601&apos; AND i.InvoiceDate &lt; &apos;20250701&apos;" StatementId="1" StatementCompId="2" StatementType="UPDATE" StatementSqlHandle="0x0900CD40472800C511EA82C4E87D2DC1C2D40000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="4" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="21.7195" StatementEstRows="18459" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x2A62C1B1298D06A1" QueryPlanHash="0x31A5377C4FD3DE13" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="67360" NonParallelPlanReason="NoParallelPlansInDesktopOrExpressEdition" CachedPlanSize="72" CompileTime="4" CompileCPU="4" CompileMemory="632"><MissingIndexes><MissingIndexGroup Impact="21.2111"><MissingIndex Database="[TuningDemo]" Schema="[dbo]" Table="[Invoice]"><ColumnGroup Usage="INEQUALITY"><Column Name="[InvoiceDate]" ColumnId="6"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[GrossAmount]" ColumnId="10"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="2560" S